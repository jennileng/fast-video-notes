# Browser-safe, RLS-gated. Committed values are the project's own; safe to ship.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER-ONLY. Bypasses RLS entirely. Never prefix with NEXT_PUBLIC_, never
# reference from a Client Component. Set in Vercel (Production + Preview) and
# in .env.local for `next dev` — do NOT commit a real value.
SUPABASE_SECRET_KEY=sb_secret_...
